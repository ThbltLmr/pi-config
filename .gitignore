# Ignore everything by default
*

# Keep repo metadata
!.gitignore
!.gitmodules
!README.md

# Pi config
!settings.json
!keybindings.json
!models.json
!AGENTS.md
!SYSTEM.md
!APPEND_SYSTEM.md

# Plugin repositories are tracked as submodules, not copied files.
!plugins/
!plugins/pi-btw
!plugins/pi-modal-editor
!plugins/pi-starship-footer

# Pi resources
!themes/
!themes/**
!prompts/
!prompts/**
!skills/
!skills/**
!extensions/
!extensions/**
!test/
!test/**

# Never version secrets, sessions, trust state, or package caches
auth.json
sessions/
trust.json
git/
npm/
/extensions/herdr-agent-state.ts
